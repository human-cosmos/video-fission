# Set to an explicit Codex executable when it is not on PATH.
CODEX_BIN=
# Address used for the local API and web app.
VF_HOST=127.0.0.1
VF_PORT=8000
# Codex conversations run against this sandbox directory.
VF_WORKSPACE=
# Optional overrides.
VF_DATA_DIR=
VF_CODEX_TIMEOUT_SECONDS=180
VF_APPROVAL_TIMEOUT_SECONDS=300

