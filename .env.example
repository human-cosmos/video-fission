# Set to an explicit Codex executable when it is not on PATH.
CODEX_BIN=
# Address used for the local API and web app.
VF_HOST=127.0.0.1
VF_PORT=8000
# Codex conversations run against this sandbox directory.
VF_WORKSPACE=
# Optional overrides.
VF_DATA_DIR=
VF_CODEX_TIMEOUT_SECONDS=180
VF_APPROVAL_TIMEOUT_SECONDS=300

# Structured runtime logging. The file is rotated automatically.
VF_LOG_LEVEL=INFO
VF_LOG_FILE=status/video-fission.log
VF_LOG_MAX_BYTES=20971520
VF_LOG_BACKUP_COUNT=10
# Set to 1 only when prompt previews are needed for debugging.
VF_LOG_PROMPTS=0
VF_LOG_PROMPT_CHARS=1200

# Authentication. Keep this enabled outside local tests.
VF_AUTH_REQUIRED=true
# Use `openssl rand -hex 32`. If omitted, a secret is generated under VF_DATA_DIR.
VF_AUTH_SECRET_KEY=
VF_AUTH_ADMIN_USERNAME=admin
# If omitted on first startup, a random password is generated and written to
# VF_DATA_DIR/bootstrap_admin.txt (mode 600).
VF_AUTH_ADMIN_PASSWORD=
VF_AUTH_TOKEN_EXPIRE_MINUTES=1440
# Optional parent domain for deployments where the API and frontend use different hosts.
VF_AUTH_COOKIE_DOMAIN=
# Extra browser origins allowed to submit authenticated API requests.
VF_ALLOWED_ORIGINS=

# CAS SSO. Leave client credentials empty to disable enterprise SSO.
VF_SSO_CLIENT_ID=
VF_SSO_CLIENT_SECRET=
VF_SSO_CLIENT_NAME=VideoFission
VF_SSO_CAS_AUTH_URL=https://manage.giikin.com/guard/sso/public/auth
VF_SSO_BUSINESS_API_URL=https://openapi.giikin.com
VF_SSO_ACCESS_TOKEN_URL=https://idc-ai.giikin.com/api/common/get_access_token
VF_SSO_CALLBACK_URL=
VF_SSO_FRONTEND_URL=http://127.0.0.1:5174

# Gemini video understanding. These values seed the initial per-user settings;
# an explicitly customized database setting still takes precedence.
VF_GEMINI_API_URL=https://openapi.giikin.com/ai/gen/v1/chat/conversationV5
VF_GEMINI_UPLOAD_URL=https://openapi.giikin.com/ai/upload/v1/gcloud
VF_GEMINI_TOKEN_URL=https://idc-ai.giikin.com/api/common/get_access_token
VF_GEMINI_MODEL=gemini-3.8-flash
VF_GEMINI_SOURCE=hot-product-system
VF_GEMINI_MAX_CONCURRENCY=6
# Production must fail instead of replacing model copy with local templates.
VF_ALLOW_LOCAL_COPY_FALLBACK=0
VF_SCRIPT_AGENT_TIMEOUT_SECONDS=900

